{
  "name": "@sohampatwardhan/iconify-mcp",
  "version": "0.2.0",
  "description": "Unofficial community MCP server for Iconify icons, with Icônes links",
  "type": "module",
  "license": "MIT",
  "author": "Soham Patwardhan",
  "homepage": "https://github.com/sohampatwardhan/iconify-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sohampatwardhan/iconify-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sohampatwardhan/iconify-mcp/issues"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "iconify",
    "icones",
    "iconify-mcp",
    "icons",
    "svg"
  ],
  "bin": {
    "iconify-mcp": "./dist/cli.js",
    "icones-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets/fonts",
    "docs/contact-sheet.png",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 src scripts test vitest.config.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@resvg/resvg-js": "^2.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
